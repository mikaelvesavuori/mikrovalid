{
  "name": "mikrovalid",
  "description": "MikroValid is the JSON validator that cuts out all the bullshit.",
  "version": "2.0.0",
  "author": "Mikael Vesavuori",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "require": "./lib/index.cjs",
      "import": "./lib/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelvesavuori/mikrovalid.git"
  },
  "keywords": [
    "json",
    "schema",
    "validation",
    "validator",
    "schema-validation",
    "object-validator"
  ],
  "bugs": {
    "url": "https://github.com/mikaelvesavuori/mikrovalid/issues"
  },
  "homepage": "https://github.com/mikaelvesavuori/mikrovalid#readme",
  "files": [
    "/lib",
    "!/lib/**/*.map",
    "!/tests"
  ],
  "scripts": {
    "start": "npx ts-node src/index.ts",
    "test": "npx vitest run --coverage",
    "test:watch": "npx vitest",
    "build": "npm run clean && tsup src --format esm,cjs --dts && mv dist lib",
    "clean": "rm -rf lib && rm -rf dist",
    "package": "npm pack",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "lint": "npx biome check --write ./src ./tests",
    "lint:check": "npx biome check ./src ./tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2",
    "@types/node": "24",
    "@vitest/coverage-v8": "5",
    "husky": "9",
    "tsup": "8",
    "typescript": "6",
    "vitest": "5"
  }
}